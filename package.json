{
  "name": "mesoft-otel",
  "version": "6.0.0",
  "description": "Mesoft Bilisim Otel Yonetim Sistemi",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "share": "electron .",
    "dist": "electron-builder --win --publish never",
    "dist:portable": "electron-builder --win portable --publish never",
    "postinstall": "electron-builder install-app-deps"
  },
  "keywords": [
    "hotel",
    "management",
    "reservation"
  ],
  "author": "Mesoft Bilisim",
  "license": "MIT",
  "dependencies": {
    "electron-updater": "^6.3.9",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^25.1.0"
  },
  "build": {
    "appId": "com.mesoftbilisim.otel",
    "productName": "Mesoft Bilisim Otel",
    "copyright": "Copyright (c) 2026 Mesoft Bilisim",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "${productName}-Kurulum-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Mesoft Bilisim Otel"
    }
  }
}